    <ns0:messageFlow id="Flow_07883k1" sourceRef="Activity_17m8we5" targetRef="Activity_1t4ou3g" />
    <ns0:textAnnotation id="TextAnnotation_07tl45p">
      <ns0:text>Наименование и номер дела</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1hy1e12">
      <ns0:text>Истец</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_09k25fd">
      <ns0:text>Ответчик</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0s56jr7">
      <ns0:text>Заслушивание показаний свидетелей, заключений специалиста, предоставление доп. материалов сторонами и проч. - внутри процесса</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1pfl5wv">
      <ns0:text>Дополнительное исследование док-в</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0bygt2m">
      <ns0:text>Признание иска ответчиком может произойти и в дальнейшем по процессу</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1o82gq1">
      <ns0:text>Отказ истца от иска может произойти и в дальнейшем по процессу</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0wq38d7">
      <ns0:text>Примирение сторон может произойти и в дальнейшем по процессу</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_19yri0c">
      <ns0:text>Переводит на протяжении всего процесса СЗ, переводчик подключается удаленно</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0qc7bnk">
      <ns0:text>Протокольное определение</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_00xa3jv">
      <ns0:text>Заведомо неправильный перевод</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_027t5nj">
      <ns0:text>Предложить заключить мировое соглашение, обратиться к судебному примирителю, применить процедуру медиации</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1hd8l9b">
      <ns0:text>Перерыв не должен превышать срока в 10 дней</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1xzzqxk">
      <ns0:text>Например, сейчас (as is) при входе в зал мы предоставляем паспорт, можно заменить на предоставление одноразового QR-code для занесения данных в систему данных о присутствующих личностях со сверкой по паспорту</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0f3ozmh">
      <ns0:text>Фиксация данных в системе для использования в шаблонах документов</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0bzddsl">
      <ns0:text>Фиксация данных в системе для использования в шаблонах документов</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0069yas">
      <ns0:text>Онлайн транскрибация видео.
Выделение части:
Ход процесса
Решение судьи</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_073x937">
      <ns0:text>Подпись через ЛК, Стороны ставят подписи в протоколе о том, что они ознакомлены с датой и временем продолжения СЗ</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0o46wnp">
      <ns0:text>Изменить в системе предмет иска</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_1vl3j47" associationDirection="None" sourceRef="Activity_1kspxwt" targetRef="TextAnnotation_19yri0c" />
    <ns0:association id="Association_1spapta" associationDirection="None" sourceRef="Activity_0tre1ja" targetRef="TextAnnotation_00xa3jv" />
    <ns0:textAnnotation id="TextAnnotation_1nb22cn">
      <ns0:text>Протокол, сформированный системой на шаге 2</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0wbfusn" associationDirection="None" sourceRef="Activity_1sbt3rd" targetRef="TextAnnotation_07tl45p" />
