  <ns0:collaboration id="Collaboration_15frzih">
    <ns0:participant id="Participant_0pfhlqc" name="Суд" processRef="Process_19ulq1w" />
    <ns0:textAnnotation id="TextAnnotation_1txoyqq">
      <ns0:text>ИС суда/Дело web</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1a05mgk">
      <ns0:text>Лицо/отдел, принимающее документ или номер дела</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0gat0ch">
      <ns0:text>Документ изымается из сущности в которой находится и переносится в новую. Если документ передается лицу или отделу, то в задаче на прием документа необходимо выбрать место для сохранения документа</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1cus9ch">
      <ns0:text>Дополнительно создается соответствующая запись в истории дела и/или документа</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1llyan1">
      <ns0:text>Дополнительно создается соответствующая запись в истории дела и/или документа</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0qohav7">
      <ns0:text>Отдельный глобальный отчет суда, в котором ведется запись о том: кто; когда; почему; что передал; принят или не принят документ; причина отказа, если документ не принят.</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_13dospp" associationDirection="None" sourceRef="Activity_1yftsus" targetRef="TextAnnotation_1a05mgk" />
    <ns0:association id="Association_18buc2f" associationDirection="None" sourceRef="Activity_1vbfdhd" targetRef="TextAnnotation_1txoyqq" />
