  <bpmn:collaboration id="Collaboration_04wgime" name="Хранение и учет архивных документов согласно правилам ведения архива">
    <bpmn:participant id="Participant_0n5k7es" processRef="Process_guptlfw" />
    <bpmn:textAnnotation id="TextAnnotation_1aeg091">
      <bpmn:text>Система позволяет выбирать архивные дела/документы для последующей передачи в Госархив</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_182hzmx">
      <bpmn:text>Система формирует и автоматически пополняет реестр</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0uo9wro">
      <bpmn:text>Хранение и контроль сроков</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_098iwgq">
      <bpmn:text>Выбрать список пользователей для "Экспертной комиссии" для определения срока хранения</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1rtc61u">
      <bpmn:text>В архивных сущностях есть словарь обуславливающий ценность документа в архиве и его срок</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0r0dxbm">
      <bpmn:text>Система автоматически добавляет в сущность судебное/номенклатурное дело которое попало в архив</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_119fufx">
      <bpmn:text>Создать задачу на председателя суда</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_11f5ubc">
      <bpmn:text>Правила хранения документов по заключению экспертной оценки</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ljz8so">
      <bpmn:text>Выбрать номер стелажа</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1m3xi2k" associationDirection="None" sourceRef="Activity_01rsldq" targetRef="TextAnnotation_0r0dxbm" />
    <bpmn:association id="Association_0xp5kv8" associationDirection="None" sourceRef="Activity_01i4bm8" targetRef="TextAnnotation_1aeg091" />
    <bpmn:association id="Association_02uudkd" associationDirection="None" sourceRef="Activity_1j78101" targetRef="TextAnnotation_1ljz8so" />
