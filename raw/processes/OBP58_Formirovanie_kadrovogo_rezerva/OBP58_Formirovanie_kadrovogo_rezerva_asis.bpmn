    <bpmn:association id="Association_01bp4oq" associationDirection="None" sourceRef="Activity_1wvdurb" targetRef="TextAnnotation_10lyqse" />
    <bpmn:association id="Association_1vq6f8p" associationDirection="None" sourceRef="Activity_0um2p3q" targetRef="TextAnnotation_1e65q7u" />
