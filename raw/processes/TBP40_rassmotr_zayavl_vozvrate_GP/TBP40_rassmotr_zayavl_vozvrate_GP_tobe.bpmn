  <ns0:collaboration id="Collaboration_05w4xgy" name="AS IS Провести возврат госпошлины (ТП)">
    <ns0:participant id="Participant_0w7cz57" name="Суд" processRef="Process_1slo0ox" />
    <ns0:participant id="Participant_1lgnpmy" name="Истец/Заявитель" processRef="Process_0lp4fa3" />
    <ns0:messageFlow id="Flow_12u8vsd" sourceRef="Activity_0ic3i80" targetRef="Event_0okmg20" />
    <ns0:messageFlow id="Flow_0w7m1nf" sourceRef="Activity_1wbbyao" targetRef="Event_036gso5" />
    <ns0:messageFlow id="Flow_1fax8cb" sourceRef="Activity_0jvis71" targetRef="Participant_0w7cz57" />
    <ns0:textAnnotation id="TextAnnotation_05a2q9q">
      <ns0:text>Типовик для обеспечивающих процессов</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1u6zxr2">
      <ns0:text>Подача документов в электронном виде через форму подачи документов в суд</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1c1i292">
      <ns0:text>Автоматические проверки, автоматическое отклонение по техническим основаниям, автоматическая регистрация, задача на валидацию, валидация регистрации сотрудником ОД, формирование связи карточки документа с карточкой дела, задача на судью</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0rm6i43">
      <ns0:text>LLM классифицирует основание по заявлению (например, «дело прекращено», «ошибочный платёж» и тд) и выдает рекомендацию</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0t01e6l">
      <ns0:text>Автоматическое формирование шаблона с рекомендациями</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0sxinfv" associationDirection="None" sourceRef="Activity_0ic3i80" targetRef="TextAnnotation_1u6zxr2" />
    <ns0:textAnnotation id="TextAnnotation_0niiwn5">
      <ns0:text>Производится возврат на основании документа и суммы в документе</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_071ww73" associationDirection="None" sourceRef="Activity_1pkhj0v" targetRef="TextAnnotation_1c1i292" />
    <ns0:association id="Association_0ggn2jb" associationDirection="None" sourceRef="Activity_18ds85c" targetRef="TextAnnotation_05a2q9q" />
    <ns0:textAnnotation id="TextAnnotation_026elg8">
      <ns0:text>OCR распознает текст
LLM выделяет номер дела и запускает процесс проверки наличия в ИС</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0mm11ur" associationDirection="None" sourceRef="Activity_0wgvdqc" targetRef="TextAnnotation_026elg8" />
    <ns0:association id="Association_17sensl" associationDirection="None" sourceRef="Activity_0duekvu" targetRef="TextAnnotation_0rm6i43" />
    <ns0:association id="Association_1d1ix79" associationDirection="None" sourceRef="Activity_1qnfv38" targetRef="TextAnnotation_0t01e6l" />
    <ns0:association id="Association_0hnl9jd" associationDirection="None" sourceRef="Activity_183brfp" targetRef="TextAnnotation_0niiwn5" />
    <ns0:textAnnotation id="TextAnnotation_1myux81">
      <ns0:text>ЛК, Email, SMS</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_1e9ez17" associationDirection="None" sourceRef="Activity_1w2wrax" targetRef="TextAnnotation_1myux81" />
    <ns0:textAnnotation id="TextAnnotation_0n1j754">
      <ns0:text>Для запуска процесса возврата требуется дата и время</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0ji0ld2" associationDirection="None" sourceRef="Activity_0jvis71" targetRef="TextAnnotation_0n1j754" />
    <ns0:textAnnotation id="TextAnnotation_08h5ftj">
      <ns0:text>система автоматически ищет совпадения по реквизитам платежа (ИНН, КБК, сумма, назначение).</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_066mj8y" associationDirection="None" sourceRef="Activity_0duekvu" targetRef="TextAnnotation_08h5ftj" />
    <ns0:textAnnotation id="TextAnnotation_1bx7b7z">
      <ns0:text>система автоматически отправляет электронное уведомление в личный кабинет заявителя (или по СМЭВ), фиксируя факт доставки.</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0xymvmq" associationDirection="None" sourceRef="Activity_0rw5u6l" targetRef="TextAnnotation_1bx7b7z" />
  </ns0:collaboration>
