  <ns0:collaboration id="Collaboration_0q5d541">
    <ns0:participant id="Participant_15eugz0" name="Суд" processRef="Process_180ucgd" />
    <ns0:textAnnotation id="TextAnnotation_1uyzfjb">
      <ns0:text>У органа или лица, которые приняли оспариваемый акт, решение или совершили оспариваемые действия (бездействие).</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_10zqd7i">
      <ns0:text>В сфере предпринимательской и иной экономической деятельности.</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1ktig7n">
      <ns0:text>Полностью или в части</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1yplni8">
      <ns0:text>Полностью или в части</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_02jntk1">
      <ns0:text>Решение об оспаривании действий (бездействий)</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0z1dttg" associationDirection="None" sourceRef="Flow_1xo4vc7" targetRef="TextAnnotation_02jntk1" />
    <ns0:textAnnotation id="TextAnnotation_0h5r22p">
      <ns0:text>Органа/должностного лица</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0mvintp">
      <ns0:text>Факты ранее установлены судьей, а не системой.</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_1rzp8yg" associationDirection="None" sourceRef="Activity_14exmir" targetRef="TextAnnotation_10zqd7i" />
    <ns0:association id="Association_1nnrn5t" associationDirection="None" sourceRef="Activity_1iw8d4u" targetRef="TextAnnotation_1uyzfjb" />
    <ns0:association id="Association_1uf61e2" associationDirection="None" sourceRef="Activity_0cwqkl0" targetRef="TextAnnotation_1ktig7n" />
    <ns0:association id="Association_1k3qcr7" associationDirection="None" sourceRef="Activity_0pay2rt" targetRef="TextAnnotation_0h5r22p" />
    <ns0:association id="Association_157758i" associationDirection="None" sourceRef="Activity_0pay2rt" targetRef="TextAnnotation_0mvintp" />
    <ns0:association id="Association_0vtthbi" associationDirection="None" sourceRef="TextAnnotation_0mvintp" targetRef="Activity_0iag94q" />
    <ns0:association id="Association_184iq22" associationDirection="None" sourceRef="TextAnnotation_0mvintp" targetRef="Activity_09jj5hs" />
    <ns0:association id="Association_0yfvqmg" associationDirection="None" sourceRef="Activity_0ep9vgc" targetRef="TextAnnotation_1yplni8" />
    <ns0:textAnnotation id="TextAnnotation_1tlzl0z">
      <ns0:text>Система указывает стандартный для такого рода дел срок, а судья далее в процессе может его проверить и пересмотреть.</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_1ar8i7g" associationDirection="None" sourceRef="Activity_01t3xzg" targetRef="TextAnnotation_1tlzl0z" />
  </ns0:collaboration>
