<?xml version='1.0' encoding='utf-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://camunda.org/schema/modeler/1.0" xmlns:ns2="http://camunda.org/schema/zeebe/1.0" xmlns:ns3="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns4="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns5="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.39.0" ns1:executionPlatform="Camunda Cloud" ns1:executionPlatformVersion="8.7.0">
  <ns0:collaboration id="Collaboration_0tn0xdv">
    <ns0:participant id="Participant_0xwt1b3" name="Председатель суда, заместитель председателя суда, председатель судебного состава, судья" processRef="Process_1rvskn2" />
    <ns0:textAnnotation id="TextAnnotation_1q02bxe">
      <ns0:text>Участвующих в деле</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_03yesuh">
      <ns0:text>в качестве прокурора, помощника судьи, секретаря судебного заседания, представителя, эксперта, специалиста, переводчика или свидетеля</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0irqyib">
      <ns0:text>либо имеются иные обстоятельства, которые могут вызвать сомнение в его беспристрастности</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1cfgj09">
      <ns0:text>от лица, участвующего в деле, или его представителя;</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1dis2z1">
      <ns0:text>которые стали поводом для обращения в арбитражный суд или используются при рассмотрении дела</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_17jybru">
      <ns0:text>Участие помощника судьи, секретаря судебного заседания, эксперта, специалиста, переводчика в предыдущем рассмотрении арбитражным судом данного дела в качестве соответственно помощника судьи, секретаря судебного заседания, эксперта, специалиста, переводчика не является основанием для их отвода. Участие секретаря судебного заседания в предыдущем рассмотрении арбитражным судом данного дела в качестве помощника судьи или участие помощника судьи в предыдущем рассмотрении арбитражным судом данного дела в качестве секретаря судебного заседания не является основанием для их отвода.</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0fdxx5j">
      <ns0:text>Фиксируем результаты проверок шагов с 2 по 11 и выводим пользователю отчет</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0nsv43c" associationDirection="None" sourceRef="Activity_0gk7ack" targetRef="TextAnnotation_1q02bxe" />
    <ns0:association id="Association_1emew62" associationDirection="None" sourceRef="Activity_0rsgsks" targetRef="TextAnnotation_03yesuh" />
    <ns0:association id="Association_1q4sdls" associationDirection="None" sourceRef="Activity_10unc3l" targetRef="TextAnnotation_0irqyib" />
    <ns0:association id="Association_0fgw8gd" associationDirection="None" sourceRef="Activity_0wao0gn" targetRef="TextAnnotation_1cfgj09" />
    <ns0:association id="Association_0sn0hjw" associationDirection="None" sourceRef="Activity_1y7rril" targetRef="TextAnnotation_0fdxx5j" />
    <ns0:textAnnotation id="TextAnnotation_0t0vfx7">
      <ns0:text>В случае поступления документа об отводе, пользователь может запустить в ручную данную проверку по делу</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0ks3591" associationDirection="None" sourceRef="Activity_0jx0ywo" targetRef="TextAnnotation_0t0vfx7" />
    <ns0:association id="Association_0dnrpsy" associationDirection="None" sourceRef="Activity_0gg1l8l" targetRef="TextAnnotation_1dis2z1" />
  </ns0:collaboration>
