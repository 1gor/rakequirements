<?xml version='1.0' encoding='utf-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://camunda.org/schema/modeler/1.0" xmlns:ns2="http://camunda.org/schema/zeebe/1.0" xmlns:ns3="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns4="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns5="http://www.omg.org/spec/DD/20100524/DI" id="sample-diagram" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.35.0" ns1:executionPlatform="Camunda Cloud" ns1:executionPlatformVersion="8.7.0">
  <ns0:collaboration id="Collaboration_0a14xkw" name="AS IS Оформить исполнительный лист">
    <ns0:participant id="Participant_0bkp4fn" name="Создание и подписание исполнительного документа" processRef="Process_0gp9x9t" />
    <ns0:textAnnotation id="TextAnnotation_1noewyu">
      <ns0:text>Сложить подписанный ИЛ и сопроводительное письмо, и СА по необходимости</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_196hsw7">
      <ns0:text>Значение необходимого количества исполнительных листов должно формироваться в объекте дела по правилам, изложенным в описании схемы. В данном варианте нужно только чтение необходимого значения</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_14r306z">
      <ns0:text>Интеграция с внешним сервисом</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0riciwg">
      <ns0:text>Перевод журнала бланков и журнала выдачи в электронный формат реестра, внесение данных на основании закрытия задачи.</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1lvfe9w">
      <ns0:text>Перевод журнала учета в формат электронного реестра</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1gitanp">
      <ns0:text>Создается задача для лица, ответственного за выдачу новых бланков. Система формирует расписание, смотрит на загруженность помощника и лица, ответственного за выдачу, назначает помощнику время получения, отражает его в задаче.</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_1tihu26" associationDirection="None" sourceRef="Activity_0yzi5uy" targetRef="TextAnnotation_196hsw7" />
    <ns0:association id="Association_1ck5x1u" associationDirection="None" sourceRef="Activity_12bn3yr" targetRef="TextAnnotation_1gitanp" />
    <ns0:textAnnotation id="TextAnnotation_0wweezp">
      <ns0:text>Проверка корректности сопроводительного письма</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_11nyiqh" associationDirection="None" sourceRef="Activity_1rdmyjx" targetRef="TextAnnotation_0wweezp" />
    <ns0:textAnnotation id="TextAnnotation_11f29rm">
      <ns0:text>Электронная гербовая печать</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0k53l2g" associationDirection="None" sourceRef="Activity_1aid9n3" targetRef="TextAnnotation_11f29rm" />
    <ns0:textAnnotation id="TextAnnotation_00sl7nt">
      <ns0:text>OCR распознает отсканированный документ,  на этом этапе система должна обладать всеми данными для проставления отметок в реестрах, пользователь проверит выводы системы</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0a30awc" associationDirection="None" sourceRef="Activity_0y6qv0w" targetRef="TextAnnotation_00sl7nt" />
    <ns0:association id="Association_1gww7ch" associationDirection="None" sourceRef="Activity_1sncz8x" targetRef="TextAnnotation_14r306z" />
    <ns0:association id="Association_0mf9wjr" associationDirection="None" sourceRef="Activity_1aigxrl" targetRef="TextAnnotation_0riciwg" />
    <ns0:association id="Association_03f0f4c" associationDirection="None" sourceRef="TextAnnotation_0riciwg" targetRef="Activity_1wuic2r" />
    <ns0:association id="Association_1mlwpzr" associationDirection="None" sourceRef="Activity_04y8wvi" targetRef="TextAnnotation_1noewyu" />
    <ns0:textAnnotation id="TextAnnotation_1i87ibp">
      <ns0:text>OCR распознает отсканированный документ,  на этом этапе система должна обладать всеми данными для проставления отметок в реестрах, пользователь проверит выводы системы</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_1djatez" associationDirection="None" sourceRef="Activity_1catjzl" targetRef="TextAnnotation_1i87ibp" />
    <ns0:textAnnotation id="TextAnnotation_1pyoych">
      <ns0:text>Сделать спец. отметки на испорченном бланке, которые будут свидетельствовать о невозможности использования бланка</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0zwqxht" associationDirection="None" sourceRef="Activity_0i35a4q" targetRef="TextAnnotation_1pyoych" />
    <ns0:association id="Association_1g83kuz" associationDirection="None" sourceRef="Activity_0yrin3q" targetRef="TextAnnotation_1lvfe9w" />
  </ns0:collaboration>
