<?xml version='1.0' encoding='utf-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://camunda.org/schema/modeler/1.0" xmlns:ns2="http://camunda.org/schema/zeebe/1.0" xmlns:ns3="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns4="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns5="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.35.0" ns1:executionPlatform="Camunda Cloud" ns1:executionPlatformVersion="8.7.0"><ns0:collaboration id="Collaboration_01a85gx" name="AS IS Рассмотреть заявление о пересмотре"><ns0:participant id="Participant_0udvzm0" processRef="Process_1ka5iho" /><ns0:textAnnotation id="TextAnnotation_1ab7bhh"><ns0:text>Система при помощи LLM и интеграций и внешних электронных сервисов проверяет факт отмены СА/постановления, послужившего основанием для принятия СА по этому делу</ns0:text></ns0:textAnnotation><ns0:textAnnotation id="TextAnnotation_1j4jzpt"><ns0:text>Система при помощи LLM анализирует СА, на основании которого проверка повлекла за собой принятие незаконного или необоснованного судебного акта по данному делу</ns0:text></ns0:textAnnotation><ns0:textAnnotation id="TextAnnotation_0e7q1b0"><ns0:text>Система при помощи LLM анализирует НПА, примененный судом при вынесении СА</ns0:text></ns0:textAnnotation><ns0:textAnnotation id="TextAnnotation_1opxdpr"><ns0:text>Система при помощи LLM анализирует установление/изменения Федеральным законом признания здания самовольной постройкой</ns0:text></ns0:textAnnotation><ns0:textAnnotation id="TextAnnotation_06ednp9"><ns0:text>Система при помощи LLM анализирует практики применения правовой нормы</ns0:text></ns0:textAnnotation><ns0:textAnnotation id="TextAnnotation_02vm0z3"><ns0:text>Один общий отчет о проверке с возможностью изменения каждой конкретной проверки/вывода</ns0:text></ns0:textAnnotation><ns0:textAnnotation id="TextAnnotation_167gbiy"><ns0:text>Только вступившие в законную силу приговоры суда</ns0:text></ns0:textAnnotation><ns0:association id="Association_0xzf1eb" associationDirection="None" sourceRef="Activity_1t212cj" targetRef="TextAnnotation_1ab7bhh" /><ns0:association id="Association_1qhldoy" associationDirection="None" sourceRef="Activity_0akmsir" targetRef="TextAnnotation_1j4jzpt" /><ns0:association id="Association_0uhpmas" associationDirection="None" sourceRef="Activity_0u91c71" targetRef="TextAnnotation_0e7q1b0" /><ns0:association id="Association_0i33xqi" associationDirection="None" sourceRef="Activity_0lsrnnb" targetRef="TextAnnotation_02vm0z3" /><ns0:association id="Association_1p6fp32" associationDirection="None" sourceRef="Activity_095p70b" targetRef="TextAnnotation_1opxdpr" /><ns0:association id="Association_0exjq9g" associationDirection="None" sourceRef="TextAnnotation_167gbiy" targetRef="Gateway_13wib5p" /><ns0:association id="Association_0qrkhvo" associationDirection="None" sourceRef="Activity_17kbbgh" targetRef="TextAnnotation_06ednp9" /></ns0:collaboration><ns0:process id="Process_1ka5iho" name="AS IS Рассмотреть вопрос о пересмотре (ТП)" isExecutable="true"><ns0:laneSet id="LaneSet_1mutpth"><ns0:lane id="Lane_1q5q50m" name="Судья"><ns0:flowNodeRef>Gateway_18y334f</ns0:flowNodeRef><ns0:flowNodeRef>Gateway_0c2fweu</ns0:flowNodeRef><ns0:flowNodeRef>Gateway_12sxse0</ns0:flowNodeRef><ns0:flowNodeRef>Gateway_1fhndk1</ns0:flowNodeRef><ns0:flowNodeRef>Gateway_1dl72gk</ns0:flowNodeRef><ns0:flowNodeRef>Gateway_07rerk7</ns0:flowNodeRef><ns0:flowNodeRef>Gateway_02ub4g2</ns0:flowNodeRef><ns0:flowNodeRef>Gateway_036s2nu</ns0:flowNodeRef><ns0:flowNodeRef>Gateway_0ec3h4s</ns0:flowNodeRef><ns0:flowNodeRef>Gateway_0u60tj9</ns0:flowNodeRef><ns0:flowNodeRef>Gateway_0b6rxwz</ns0:flowNodeRef><ns0:flowNodeRef>Gateway_1we3uzx</ns0:flowNodeRef><ns0:flowNodeRef>Gateway_14547an</ns0:flowNodeRef><ns0:flowNodeRef>Gateway_0h5b9aj</ns0:flowNodeRef><ns0:flowNodeRef>Activity_1t212cj</ns0:flowNodeRef><ns0:flowNodeRef>Activity_0akmsir</ns0:flowNodeRef><ns0:flowNodeRef>Acti