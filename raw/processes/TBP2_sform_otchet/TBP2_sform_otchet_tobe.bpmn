<?xml version='1.0' encoding='utf-8'?>
<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://camunda.org/schema/modeler/1.0" xmlns:ns2="http://camunda.org/schema/zeebe/1.0" xmlns:ns3="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns4="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns5="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.39.0" ns1:executionPlatform="Camunda Cloud" ns1:executionPlatformVersion="8.7.0">
  <ns0:collaboration id="Collaboration_1dep5li" name="AS IS Сформировать отчет (ТП)">
    <ns0:participant id="Participant_0vnb9po" name="Суд" processRef="Process_64lbnfj" />
    <ns0:textAnnotation id="TextAnnotation_0hgxeao">
      <ns0:text>Word, Ecxel, PDF. Откроется программа, установленная по умолчанию</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_02hkwb7">
      <ns0:text>Например, для отчетов Ф._</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1th61p7">
      <ns0:text>Статистические отчеты автоматически формируются без пользователя</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0vw4ule">
      <ns0:text>Позволит сократить время на скачивание файла отчета с ошибками ФЛК</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1cftcda">
      <ns0:text>Система выводит пользователю данные об ошибках в виде отчета с ответственными и ошибками</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0kfe8jz">
      <ns0:text>Передача ошибок на устранение</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1cepgjh">
      <ns0:text>23. После устранения повторный запуск формирования</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0wwikhp">
      <ns0:text>Отчет имеет память фильтров для пользователя</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0tnu2h2">
      <ns0:text>Отчет и его фильтры позволяют без выгрузки работать с данными</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0ohyg1a">
      <ns0:text>Если пользователь самостоятельно не исправляет ошибки отчета, то в шаге 19. Сформированная задача отмечает данного пользователя и уведомляет его об изменении статуса задачи для повторного запуска формирования отчета</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_068ol0q" associationDirection="None" sourceRef="Task_0sqitg9" targetRef="TextAnnotation_0hgxeao" />
    <ns0:association id="Association_076v0qg" associationDirection="None" sourceRef="Activity_1sjzqlt" targetRef="TextAnnotation_02hkwb7" />
