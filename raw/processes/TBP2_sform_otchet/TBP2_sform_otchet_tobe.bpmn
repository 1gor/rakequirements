      <ns0:text>Формируется отчет и ФЛК, ФЛК проверяется на наличие строк и ошибок.</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0569uvu" associationDirection="None" sourceRef="Activity_0osii45" targetRef="TextAnnotation_11vd4y6" />
