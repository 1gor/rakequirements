    <ns0:association id="Association_0zlat90" associationDirection="None" sourceRef="Activity_0zuwqtl" targetRef="TextAnnotation_0zduhed" />
    <ns0:textAnnotation id="TextAnnotation_0ckl9f2">
      <ns0:text>Указывается в СА</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_1x75rai" associationDirection="None" sourceRef="Activity_1l9xsph" targetRef="TextAnnotation_0ckl9f2" />
