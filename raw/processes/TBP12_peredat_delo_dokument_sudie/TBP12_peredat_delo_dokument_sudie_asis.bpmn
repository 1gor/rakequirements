  <ns0:collaboration id="Collaboration_1bcph46" name="AS IS Передать дело/документ судье (ТП)">
    <ns0:participant id="Participant_0bm1o8f" processRef="Process_3tnrijh" />
    <ns0:textAnnotation id="TextAnnotation_10bimye">
      <ns0:text>САД или САС</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0tg15mh">
      <ns0:text>САС или ПК САД</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0c70cci">
      <ns0:text>САС или САД</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0lp93kd">
      <ns0:text>Реестр учета входящей корреспонденции/передачи дел</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_1mu68i4" associationDirection="None" sourceRef="Activity_0mi8es1" targetRef="TextAnnotation_10bimye" />
    <ns0:textAnnotation id="TextAnnotation_1tvrh5r">
      <ns0:text>Если дело/документ передается после распределения - то он должен быть передан в день распределения. Если документ не требовал распределения, то он может быть передан не позднее первой половины следующего рабочего дня с момента поступления, за исключением, если документ поступил на имя председателя суда - тогда он должен быть передан в день поступления.</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0e8hwx7" associationDirection="None" sourceRef="Activity_1ckg015" targetRef="TextAnnotation_0c70cci" />
