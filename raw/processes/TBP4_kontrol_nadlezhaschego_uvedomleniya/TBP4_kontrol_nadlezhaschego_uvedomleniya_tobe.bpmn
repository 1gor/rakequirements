<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://camunda.org/schema/modeler/1.0" xmlns:ns2="http://camunda.org/schema/zeebe/1.0" xmlns:ns3="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns4="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns5="http://www.omg.org/spec/DD/20100524/DI" id="sample-diagram" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.6.1" ns1:executionPlatform="Camunda Cloud" ns1:executionPlatformVersion="8.7.0">
  <ns0:collaboration id="Collaboration_0eabq86" name="AS IS Контроль надлежащего уведомления (ТП)">
    <ns0:participant id="Participant_1m58td7" name="Суд" processRef="Process_a81ofp2" />
    <ns0:textAnnotation id="TextAnnotation_0y2zx6d">
      <ns0:text>После получения данных по факсу, к делу прикрепляется файл, распознается OCR и записываются данные о статусе уведомления участника</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_17unl6s">
      <ns0:text>Производится запись телефонограммы и направление в дело для распознания, и записи статуса уведомления участника</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_11b5cbw">
      <ns0:text>Данные о телеграмме и отметка поступают по интеграционному каналу, и записываются в дело по конкретному участнику</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1laxdmh">
      <ns0:text>В каждом документе формируется список ЛУВД для ознакомления, у каждого участника есть способ извещения со статусом</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_01nv0ug">
      <ns0:text>Есть возможность провалиться в каждое уведомление и ознакомиться подробно с доказательствами надлежащего уведомления</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1ngvnvu">
      <ns0:text>Есть возможность провалиться в каждое уведомление и ознакомиться подробно с доказательствами ненадлежащего уведомления</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1c6dp3y">
      <ns0:text>Система рассчитывает дату ознакомления для уведомления пользователя и готовности статусов участников,</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_18i47nh" associationDirection="None" sourceRef="Activity_1oe85el" targetRef="TextAnnotation_1laxdmh" />
    <ns0:association id="Association_1kflx7o" associationDirection="None" sourceRef="Activity_1gibx8x" targetRef="TextAnnotation_01nv0ug" />
    <ns0:association id="Association_00a4aoq" associationDirection="None" sourceRef="Activity_04dntki" targetRef="TextAnnotation_1ngvnvu" />
    <ns0:association id="Association_0ioxyso" associationDirection="None" sourceRef="Activity_1h8s3wu" targetRef="TextAnnotation_1c6dp3y" />
  </ns0:collaboration>
