  <ns0:collaboration id="Collaboration_05w4xgy" name="AS IS Провести возврат госпошлины (ТП)">
    <ns0:participant id="Participant_0w7cz57" name="Суд" processRef="Process_y5uc7cy" />
    <ns0:participant id="Participant_1lgnpmy" name="Истец/Заявитель" processRef="Process_hdkdqld" />
