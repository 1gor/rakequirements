        <ns0:flowNodeRef>Event_02pa5fx</ns0:flowNodeRef>
        <ns0:flowNodeRef>Event_1rftx5i</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="StartEvent_1" name="0. Появилась необходимость проконтролировать полноту рассмотрения ходатайств и заявлений">
      <ns0:outgoing>SequenceFlow_0urmf3n</ns0:outgoing>
    </ns0:startEvent>
    <ns0:sequenceFlow id="SequenceFlow_0urmf3n" sourceRef="StartEvent_1" targetRef="Task_0dqpwqm" />
    <ns0:sequenceFlow id="SequenceFlow_1g2l33u" sourceRef="Task_0dqpwqm" targetRef="Gateway_1ihuf58" />
    <ns0:manualTask id="Task_0dqpwqm" name="1. Учёт всех поступающих и ходатайств и заявлений">
      <ns0:incoming>SequenceFlow_0urmf3n</ns0:incoming>
      <ns0:outgoing>SequenceFlow_1g2l33u</ns0:outgoing>
