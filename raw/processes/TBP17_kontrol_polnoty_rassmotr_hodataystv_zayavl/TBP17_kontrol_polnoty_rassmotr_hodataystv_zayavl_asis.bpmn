    <ns0:sequenceFlow id="Flow_1oua9x8" name="Нет" sourceRef="Gateway_1ihuf58" targetRef="Gateway_0h0i94j" />
    <ns0:manualTask id="Task_0me69e9" name="3. Анализ ходатайств/заявлений, по которым проведены СЗ">
      <ns0:incoming>Flow_01vgx02</ns0:incoming>
      <ns0:outgoing>Flow_0bdxzqw</ns0:outgoing>
    </ns0:manualTask>
    <ns0:sequenceFlow id="Flow_0k117t0" name="Да" sourceRef="ExclusiveGateway_0rkt9u2" targetRef="Event_1rftx5i" />
    <ns0:endEvent id="Event_02pa5fx" name="7. Контроль пройден">
      <ns0:incoming>Flow_0nyl1db</ns0:incoming>
    </ns0:endEvent>
    <ns0:sequenceFlow id="Flow_0nyl1db" name="Нет" sourceRef="ExclusiveGateway_0rkt9u2" targetRef="Event_02pa5fx" />
    <ns0:endEvent id="Event_1rftx5i" name="8. Контроль не пройден">
      <ns0:incoming>Flow_0k117t0</ns0:incoming>
    </ns0:endEvent>
  </ns0:process>
