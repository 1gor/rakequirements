    <ns0:task id="Task_0sn0yo9" name="5. Проверить вынесение СА по всем ходатайствам и заявлениям">
      <ns0:incoming>Flow_08klj9b</ns0:incoming>
      <ns0:outgoing>SequenceFlow_1a0fgen</ns0:outgoing>
    </ns0:task>
    <ns0:exclusiveGateway id="ExclusiveGateway_0rkt9u2" name="6. Найдены нерассмотренные ходатайства?">
      <ns0:incoming>SequenceFlow_1a0fgen</ns0:incoming>
      <ns0:outgoing>Flow_0k117t0</ns0:outgoing>
      <ns0:outgoing>Flow_0nyl1db</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:exclusiveGateway id="Gateway_1ihuf58" name="2. Заявление/ходатайство рассматривается в СЗ?">
      <ns0:incoming>SequenceFlow_1g2l33u</ns0:incoming>
      <ns0:outgoing>Flow_01vgx02</ns0:outgoing>
      <ns0:outgoing>Flow_1oua9x8</ns0:outgoing>
    </ns0:exclusiveGateway>
    <ns0:sequenceFlow id="Flow_01vgx02" name="Да" sourceRef="Gateway_1ihuf58" targetRef="Task_0me69e9" />
    <ns0:exclusiveGateway id="Gateway_0h0i94j" name="4.">
      <ns0:incoming>Flow_0bdxzqw</ns0:incoming>
      <ns0:incoming>Flow_1oua9x8</ns0:incoming>
      <ns0:outgoing>Flow_08klj9b</ns0:outgoing>
