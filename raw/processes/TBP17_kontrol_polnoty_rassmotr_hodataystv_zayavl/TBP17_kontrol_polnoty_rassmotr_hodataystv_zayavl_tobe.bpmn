        <ns0:flowNodeRef>Event_1rftx5i</ns0:flowNodeRef>
        <ns0:flowNodeRef>Activity_0hufxuo</ns0:flowNodeRef>
      </ns0:lane>
    </ns0:laneSet>
    <ns0:startEvent id="StartEvent_1" name="0. Появилась необходимость проконтролировать полноту рассмотрения ходатайств и заявлений">
      <ns0:outgoing>SequenceFlow_0urmf3n</ns0:outgoing>
    </ns0:startEvent>
    <ns0:exclusiveGateway id="Gateway_1ihuf58" name="2. Заявление/ходатайство рассматривается в СЗ?">
      <ns0:incoming>SequenceFlow_1g2l33u</ns0:incoming>
      <ns0:outgoing>Flow_01vgx02</ns0:outgoing>
      <ns0:outgoing>Flow_1oua9x8</ns0:outgoing>
    </ns0:exclusiveGateway>
