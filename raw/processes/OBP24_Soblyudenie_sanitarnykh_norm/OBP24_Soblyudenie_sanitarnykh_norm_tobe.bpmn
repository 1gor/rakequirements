    <ns0:startEvent id="Event_19zi8wj" name="0. Согласно графику госзакупок наступила дата ежегодного заключения контракта на оказание услуг по уборке помещений">
      <ns0:outgoing>Flow_1q6ir9i</ns0:outgoing>
