    <ns0:association id="Association_0v14d2f" associationDirection="None" sourceRef="Activity_1ul2eby" targetRef="TextAnnotation_17blk19" />
    <ns0:textAnnotation id="TextAnnotation_0r3ysjw">
      <ns0:text>Система формирует пред заполненный шаблон Штрафа, Судья проверяет и выносит его.</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_1vlqnxy" associationDirection="None" sourceRef="Activity_0kwuxkw" targetRef="TextAnnotation_0r3ysjw" />
    <ns0:association id="Association_0l5dbl3" associationDirection="None" sourceRef="Activity_0uin0xz" targetRef="TextAnnotation_0r3ysjw" />
    <ns0:association id="Association_1joul5g" associationDirection="None" sourceRef="Activity_0zjvg1q" targetRef="TextAnnotation_1fniz3a" />
    <ns0:textAnnotation id="TextAnnotation_0ginnw0">
      <ns0:text>Регистрация и добавление Квитанции в дело, без создания дополнительных задач.</ns0:text>
    </ns0:textAnnotation>
