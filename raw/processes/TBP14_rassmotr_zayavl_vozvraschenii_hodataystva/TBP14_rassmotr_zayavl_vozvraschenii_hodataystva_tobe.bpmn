    <ns0:textAnnotation id="TextAnnotation_17blk19">
      <ns0:text>Система используя ASR распознает речь и формирует протокол СЗ. Помощник контролирует и валидирует процесс ведения протокола системой</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_18k7h41">
      <ns0:text>To be процесс с учетом to be Провести анализ документа.
Формирование проекта СА, задача судье на подписание СА</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1sabkoe">
      <ns0:text>to be процесс Электронное заявление, предусматривающее автоматическую валидацию данных + заполнение необходимого в силу АПК</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0rl8hg2" associationDirection="None" sourceRef="Activity_1o4dzzy" targetRef="TextAnnotation_17blk19" />
    <ns0:association id="Association_0748er3" associationDirection="None" sourceRef="Activity_174fpko" targetRef="TextAnnotation_18k7h41" />
    <ns0:association id="Association_1t52zvx" associationDirection="None" sourceRef="Activity_0iyr0g4" targetRef="TextAnnotation_1sabkoe" />
    <ns0:textAnnotation id="TextAnnotation_1sg0iph">
      <ns0:text>Действие должно происходить вне Системы</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0pyjtdy" associationDirection="None" sourceRef="Activity_0pz9i96" targetRef="TextAnnotation_1sg0iph" />
  </ns0:collaboration>
