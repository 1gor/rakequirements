<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns2="http://camunda.org/schema/zeebe/1.0" xmlns:ns5="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:ns6="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:ns7="http://www.omg.org/spec/DD/20100524/DI" xmlns:ns1="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.35.0" ns1:executionPlatform="Camunda Cloud" ns1:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_0xmfvni">
    <bpmn:participant id="Participant_0jcv303" name="Суд" processRef="Process_1jvkfen" />
    <bpmn:participant id="Participant_16wahkr" name="УСД" />
    <bpmn:messageFlow id="Flow_0t3ctjc" sourceRef="Activity_1md8ih5" targetRef="Participant_16wahkr" />
    <bpmn:textAnnotation id="TextAnnotation_0pop1kw">
      <bpmn:text>Например: оплата труда, материальные расходы (включая закупку оргтехники, мебели, канцтоваров), командировочные расходы, расходы на оплату услуг связи, коммунальные услуги, прочие расходы.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0z29aqm">
      <bpmn:text>В обоснование приводятся расчеты и ссылки на соответствующие нормативные акты.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1gvmo27">
      <bpmn:text>"БА" = Бюджетное ассигнование</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_04y792n">
      <bpmn:text>Например, количество рассматриваемых дел, численность сотрудников, объем работ</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1p1vkob">
      <bpmn:text>Для выполнения судом своих функций.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1m7s5p4">
      <bpmn:text>Создание основного объекта (карточки), где будут храниться Рекомендация, Смета расходов, Отчет, Форма по ОКУД и Замечания (если есть)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0ltuy8i" associationDirection="None" sourceRef="Activity_1wu1mck" targetRef="TextAnnotation_0pop1kw" />
    <bpmn:association id="Association_0d3dsh7" associationDirection="None" sourceRef="Activity_1u4sm42" targetRef="TextAnnotation_1gvmo27" />
    <bpmn:association id="Association_1jbz1kf" associationDirection="None" sourceRef="Activity_0th361t" targetRef="TextAnnotation_0z29aqm" />
    <bpmn:association id="Association_09umnay" associationDirection="None" sourceRef="Activity_1hs2c6v" targetRef="TextAnnotation_04y792n" />
    <bpmn:association id="Association_0kkaeo6" associationDirection="None" sourceRef="Activity_1j961lv" targetRef="TextAnnotation_1p1vkob" />
    <bpmn:association id="Association_04sbh4s" associationDirection="None" sourceRef="Activity_1u892bj" targetRef="TextAnnotation_1m7s5p4" />
    <bpmn:textAnnotation id="TextAnnotation_0bvaie1">
      <bpmn:text>Карточка "Обоснование потребности в БА" обновляется, пользователь создает в ней раздел "Смета расходов"</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1cu00ty" associationDirection="None" sourceRef="Activity_1h5fr02" targetRef="TextAnnotation_0bvaie1" />
  </bpmn:collaboration>
