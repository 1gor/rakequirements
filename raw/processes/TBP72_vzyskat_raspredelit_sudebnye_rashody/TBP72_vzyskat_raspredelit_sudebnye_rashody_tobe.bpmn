<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://camunda.org/schema/modeler/1.0" xmlns:ns2="http://camunda.org/schema/zeebe/1.0" xmlns:ns3="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns4="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns5="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.38.0" ns1:executionPlatform="Camunda Cloud" ns1:executionPlatformVersion="8.7.0">
  <ns0:collaboration id="Collaboration_05oaniz" name="TBP72_vzyskat_raspredelit_sudebnye_rashody_bpmn_tobe_ПослеРевью">
    <ns0:participant id="Participant_0niups1" name="Суд" processRef="Process_1b0ax9t" />
    <ns0:textAnnotation id="TextAnnotation_1kdqne9">
      <ns0:text>Разумными следует считать такие расходы на оплату услуг представителя, которые при сравнимых обстоятельствах обычно взимаются за аналогичные услуги. (п. 13 Постановления Пленума ВС РФ № 1)</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_09f2m06">
      <ns0:text>Не заявляющих самостоятельных требований, но участвующих в деле</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_011hklc">
      <ns0:text>По обжалованию</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_007dx91">
      <ns0:text>Издержек всех участников процесса</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1qgwmpf">
      <ns0:text>Действия/бездействия</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_13rk19c">
      <ns0:text>Пополам</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0a2nexc">
      <ns0:text>Те издержки, которые связаны с рассмотрением жалобы</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1wnch6c">
      <ns0:text>Взыскать со сторон</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_10tr1qg">
      <ns0:text>Кроме гос.пошлины</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_13ct519" associationDirection="None" sourceRef="Activity_04jsym3" targetRef="TextAnnotation_1kdqne9" />
    <ns0:association id="Association_09m3jwa" associationDirection="None" sourceRef="Activity_1qjqaty" targetRef="TextAnnotation_09f2m06" />
