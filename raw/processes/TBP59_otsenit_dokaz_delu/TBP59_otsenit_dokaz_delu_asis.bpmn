    <ns0:textAnnotation id="TextAnnotation_105ds4f">
      <ns0:text>Результат оценки доказательств суд отражает  в СА</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_034pe2o">
      <ns0:text>Какие установлены и какие не установлены</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1aoy0a0">
      <ns0:text>Необходимо для оценки достаточности доказательств</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0h5i4c5">
      <ns0:text>С этого шага идет оценка всего массива доказательств в совокупности</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_02l8jze">
      <ns0:text>Ст. 69 АПК РФ</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_08p5vt8" associationDirection="None" sourceRef="Activity_1d9g2yo" targetRef="TextAnnotation_02l8jze" />
    <ns0:association id="Association_10emahc" associationDirection="None" sourceRef="Activity_1uc5z4i" targetRef="TextAnnotation_1aoy0a0" />
    <ns0:textAnnotation id="TextAnnotation_0xwl61f">
      <ns0:text>Ст. 70 АПК РФ. Если обстоятельства признаны сторонами, они считаются освобожденными от доказывания</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0xfwsui" associationDirection="None" sourceRef="Activity_1fchid2" targetRef="TextAnnotation_0xwl61f" />
