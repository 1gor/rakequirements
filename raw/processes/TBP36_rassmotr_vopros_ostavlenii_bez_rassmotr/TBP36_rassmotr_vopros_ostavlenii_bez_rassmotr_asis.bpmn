    <ns0:textAnnotation id="TextAnnotation_0arpqd2">
      <ns0:text>Дело будет оставлено без рассмотрения, если в производстве арбитражного суда, суда общей юрисдикции, третейского суда имеется дело по спору между теми же лицами, о том же предмете и по тем же основаниям.</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0q3dhq3" associationDirection="None" sourceRef="Activity_01bhgri" targetRef="TextAnnotation_0arpqd2" />
