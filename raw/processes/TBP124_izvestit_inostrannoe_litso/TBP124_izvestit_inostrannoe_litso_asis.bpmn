    <ns0:textAnnotation id="TextAnnotation_07mhaej">
      <ns0:text>На русском и иностранном языке</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_07pghd2">
      <ns0:text>Министерство юстиции направляет либо через иностранный суд, либо через компетентный орган иностранного государства</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_1fpk243" associationDirection="None" sourceRef="Participant_1i5sb88" targetRef="TextAnnotation_07pghd2" />
    <ns0:textAnnotation id="TextAnnotation_1ney60o">
      <ns0:text>Компетентный орган иностранного государства направляет напрямую иностранному лицу или через иностранный суд</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0nmqkxv" associationDirection="None" sourceRef="Participant_1pjpcpx" targetRef="TextAnnotation_1ney60o" />
