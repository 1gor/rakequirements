  <ns0:collaboration id="Collaboration_17ew63v" name="OBP16_informirovanie_rabotnikov_suda_ob_izmeneniyah_v_zakonodatelstve_formirovanii_sudebnoy_praktiki">
    <ns0:participant id="Participant_01moqvi" name="Суд" processRef="Process_1" />
    <ns0:textAnnotation id="TextAnnotation_0sknrep">
      <ns0:text>Система, Консультант, Гарант, открытые источники</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0dqpgea">
      <ns0:text>В файловом хранилище или на внутреннем портале</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_0xg5h9b">
      <ns0:text>Уведомление об изменениях в законе</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_19i9tym">
      <ns0:text>Решение принимается на шаге 2. Ознакомиться с изменениями</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1xdgxh7">
      <ns0:text>Создается отдельный объект в системе, в него добавляются необходимые участники и  изменения внесенные в закон. История обсуждения, и принятое решение будут сохранены внутри объекта. Обсуждение может идти устно с протоколом (аудио + расшифровка) или через сообщения внутри объекта.</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_06n00jt" associationDirection="None" sourceRef="Activity_1ins8zq" targetRef="TextAnnotation_0sknrep" />
    <ns0:association id="Association_0h3zpad" associationDirection="None" sourceRef="Activity_0lta92g" targetRef="TextAnnotation_0dqpgea" />
