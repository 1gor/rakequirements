    <ns0:textAnnotation id="TextAnnotation_1kzpe3b">
      <ns0:text>Используются данные из рекомендации, где присутствует ответ на наличие/отсутствие приложения или заявленных документов</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0l1goow" associationDirection="None" sourceRef="Activity_069uitw" targetRef="TextAnnotation_1kzpe3b" />
