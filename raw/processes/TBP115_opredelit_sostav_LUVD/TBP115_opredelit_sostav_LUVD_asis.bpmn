    <ns0:textAnnotation id="TextAnnotation_1055qp8">
      <ns0:text>Лицами, участвующими в деле, являются: стороны/заявители и заинтересованные лица - по делам особого производства, по делам о несостоятельности (банкротстве) и в иных предусмотренных настоящим Кодексом случаях;</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0h8u3sl" associationDirection="None" sourceRef="Activity_0xw8js4" targetRef="TextAnnotation_1055qp8" />
    <ns0:textAnnotation id="TextAnnotation_0v20pp8">
      <ns0:text>По защите прав предпринимателей</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0d5ldtb" associationDirection="None" sourceRef="Activity_0lew31h" targetRef="TextAnnotation_0v20pp8" />
