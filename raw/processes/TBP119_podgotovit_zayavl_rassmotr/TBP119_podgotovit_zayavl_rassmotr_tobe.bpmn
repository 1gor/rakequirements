<ns0:definitions xmlns:ns0="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:ns1="http://camunda.org/schema/modeler/1.0" xmlns:ns2="http://camunda.org/schema/zeebe/1.0" xmlns:ns3="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:ns4="http://www.omg.org/spec/DD/20100524/DC" xmlns:ns5="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.39.0" ns1:executionPlatform="Camunda Cloud" ns1:executionPlatformVersion="8.7.0">
  <ns0:collaboration id="Collaboration_0vxkhx7">
    <ns0:participant id="Participant_1w4325e" name="Суд" processRef="Process_0ykrsfi" />
    <ns0:textAnnotation id="TextAnnotation_07ymeqh">
      <ns0:text>Общему порядку рассмотрения заявления</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1xvxx27">
      <ns0:text>Суд вправе перейти к общему порядку рассмотрения обособленного спора при необходимости назначить экспертизу, заслушать свидетельские показания, выяснить дополнительные обстоятельства или исследовать дополнительные доказательства</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1kqau5w">
      <ns0:text>Извещение путем публикации</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1j37xf3">
      <ns0:text>При поступлении материалов дела, ИИ формирует рекомендацию по дальнейшим шагам, с ссылками на абзацы текста из которых следует вывод:
1. На основе материалов дела
2. На основе поступивших отзывов/возражений сторон
3. Поступившие дополнительные документы от сторон
4. На основе документов от АУ/Кредиторов
5. Проверка достаточности документации для определения количества заявлений/ходатайств по которым необходимо будет принять решение</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_0oko8km" associationDirection="None" sourceRef="Activity_1jaa2bk" targetRef="TextAnnotation_07ymeqh" />
    <ns0:association id="Association_1vax1xi" associationDirection="None" sourceRef="Gateway_1bnt60c" targetRef="TextAnnotation_1xvxx27" />
    <ns0:association id="Association_15cnlnt" associationDirection="None" sourceRef="Activity_1dsktbl" targetRef="TextAnnotation_1kqau5w" />
  </ns0:collaboration>
