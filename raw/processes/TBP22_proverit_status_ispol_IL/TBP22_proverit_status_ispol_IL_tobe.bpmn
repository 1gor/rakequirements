  <ns0:collaboration id="Collaboration_0y0pkni" name="AS IS Мониторинг исполнения ИЛ (ТП)">
    <ns0:participant id="Participant_0wuxvbn" name="Суд" processRef="Process_1yni1ez" />
    <ns0:textAnnotation id="TextAnnotation_15rkyk6">
      <ns0:text>Направляется в ФССП. Получение ответа - внутри схемы процесса</ns0:text>
    </ns0:textAnnotation>
    <ns0:textAnnotation id="TextAnnotation_1eho11f">
      <ns0:text>После выдачи исполнительного листа система начинает мониторить его статус через ФССП, актуальна информация заносится в карточку дела.</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_1624r19" associationDirection="None" sourceRef="Activity_0g7h9gn" targetRef="TextAnnotation_1eho11f" />
    <ns0:textAnnotation id="TextAnnotation_1k95mh8">
      <ns0:text>Система предоставляет данные, полученные в ходе парсинга сайта ФССП</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_10fvmw0" associationDirection="None" sourceRef="Activity_10zqpex" targetRef="TextAnnotation_1k95mh8" />
    <ns0:association id="Association_0pst9we" associationDirection="None" sourceRef="Activity_155yeaj" targetRef="TextAnnotation_15rkyk6" />
    <ns0:textAnnotation id="TextAnnotation_1cxsdbr">
      <ns0:text>Через событие (колокольчик)</ns0:text>
    </ns0:textAnnotation>
    <ns0:association id="Association_01i0vds" associationDirection="None" sourceRef="Activity_1bal1x9" targetRef="TextAnnotation_1cxsdbr" />
  </ns0:collaboration>
