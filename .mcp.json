{
    "mcpServers": {
        "ruby-console": {
            "command": "npx",
            "args": [
                "-y",
                "ruby-console-mcp"
            ],
            "env": {
                "RUBY_APP_PATH": "/home/id/Work/DIT/rakequirements",
                "RUBY_CONSOLE_COMMAND": "bundle exec irb"
            }
        },
        "filesystem": {
            "command": "bundle",
            "args": [
                "exec",
                "ruby",
                "/home/id/lib/file_system_mcp/file_system_mcp.rb",
                "/home/id/Work/DIT/rakequirements"
            ],
            "env": {
                "BUNDLE_GEMFILE": "/home/id/lib/file_system_mcp/Gemfile"
            }
        }
    }
}
